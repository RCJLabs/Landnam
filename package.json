{
  "name": "landnam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "play": "vite-node scripts/play.ts --",
    "record": "vite-node scripts/record.ts --",
    "offline": "npm run build && node scripts/offline.mjs",
    "test:watch": "vitest",
    "release": "npm run build && node scripts/release.mjs",
    "publish": "npm run build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.0"
  }
}
