{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  // `scripts` is in the include now, and it was not before.
  //
  // The generators write the C++ port's tables, and nothing typechecked
  // them: `BASE_EVENT_CHANCE` stopped being exported for ten minutes and the
  // literal text `undefined` went straight into a generated header, to be
  // caught a repo away by a C++ compiler. Content that reaches the port
  // deserves the same bar as content that reaches the game.
  "include": ["src", "test", "scripts"]
}
